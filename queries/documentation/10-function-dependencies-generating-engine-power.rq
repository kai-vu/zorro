# Which functions depend on "Generating power", and which functions does "Generating power" depend on?

PREFIX : <https://w3id.org/ZorroOntology#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

PREFIX : <https://w3id.org/ZorroOntology#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

SELECT ?relatedFunction ?relation
WHERE {
  GRAPH <https://w3id.org/ZorroOntology/graph/functions> {
    {
      ?relatedFunction a :Function ;
                       :dependsOn :GeneratingPower .
      BIND("depends on Generating power" AS ?relation)
    }
    UNION
    {
      :GeneratingPower :dependsOn ?relatedFunction .
      BIND("depended on by Generating power" AS ?relation)
    }
  }
}
ORDER BY ?relation ?relatedFunction
