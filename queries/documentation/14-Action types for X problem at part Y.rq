# Action types for X problem at part Y?

PREFIX : <https://w3id.org/ZorroOntology#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>


SELECT ?action ?problem
WHERE {
  ?action a ?actionType ;
          :dealsWith ?problem .
  ?problem a :LooseProblem ;
          :involves ?part.
  ?part a :RockerBoxCover.
}