# Problem associated with location X at part Y?

PREFIX : <https://w3id.org/ZorroOntology#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

SELECT ?event
WHERE {
  ?event :hasProblem ?problem .

  ?problem
      a :LooseProblem ;
      :involves ?part ;
      :location "ALL CYL" .

  ?part a :Screws .
}
