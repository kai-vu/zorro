# Problem associated with location X at part Y?

PREFIX : <https://w3id.org/ZorroOntology#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

SELECT ?problem
WHERE {
  GRAPH <https://w3id.org/ZorroOntology/graph/extractions-regex>{
  ?problem a ?problemType ;
      :involves :BaffleScrew;
      :location "R/H REAR" .
   ?problemType rdfs:subClassOf :Problem
  }}
