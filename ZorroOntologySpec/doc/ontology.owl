<?xml version="1.0"?>
<rdf:RDF xmlns="http://w3id.org/ZorroOntology/"
     xml:base="http://w3id.org/ZorroOntology/"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#">
    <owl:Ontology rdf:about="http://w3id.org/ZorroOntology/"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://w3id.org/ZorroOntology/PartOf -->


    <owl:ObjectProperty rdf:about="http://w3id.org/ZorroOntology/PartOf">
        <rdfs:domain rdf:resource="http://w3id.org/ZorroOntology/Part"/>
        <rdfs:range rdf:resource="http://w3id.org/ZorroOntology/Assembly"/>
    </owl:ObjectProperty>
    


    <!-- http://w3id.org/ZorroOntology/defines -->


    <owl:ObjectProperty rdf:about="http://w3id.org/ZorroOntology/defines">
        <rdfs:domain rdf:resource="http://w3id.org/ZorroOntology/Function"/>
        <rdfs:range rdf:resource="http://w3id.org/ZorroOntology/Problem"/>
    </owl:ObjectProperty>
    


    <!-- http://w3id.org/ZorroOntology/dependsOn -->


    <owl:ObjectProperty rdf:about="http://w3id.org/ZorroOntology/dependsOn">
        <rdfs:domain rdf:resource="http://w3id.org/ZorroOntology/Function"/>
        <rdfs:range rdf:resource="http://w3id.org/ZorroOntology/Function"/>
    </owl:ObjectProperty>
    


    <!-- http://w3id.org/ZorroOntology/failsVia -->


    <owl:ObjectProperty rdf:about="http://w3id.org/ZorroOntology/failsVia">
        <rdfs:domain rdf:resource="http://w3id.org/ZorroOntology/Component"/>
        <rdfs:range rdf:resource="http://w3id.org/ZorroOntology/Problem"/>
    </owl:ObjectProperty>
    


    <!-- http://w3id.org/ZorroOntology/hasCause -->


    <owl:ObjectProperty rdf:about="http://w3id.org/ZorroOntology/hasCause">
        <rdfs:domain rdf:resource="http://w3id.org/ZorroOntology/Problem"/>
        <rdfs:range rdf:resource="http://w3id.org/ZorroOntology/Cause"/>
    </owl:ObjectProperty>
    


    <!-- http://w3id.org/ZorroOntology/hasFunction -->


    <owl:ObjectProperty rdf:about="http://w3id.org/ZorroOntology/hasFunction">
        <rdfs:domain rdf:resource="http://w3id.org/ZorroOntology/Component"/>
        <rdfs:range rdf:resource="http://w3id.org/ZorroOntology/Function"/>
    </owl:ObjectProperty>
    


    <!-- http://w3id.org/ZorroOntology/inSystem -->


    <owl:ObjectProperty rdf:about="http://w3id.org/ZorroOntology/inSystem">
        <rdfs:domain rdf:resource="http://w3id.org/ZorroOntology/Assembly"/>
        <rdfs:range rdf:resource="http://w3id.org/ZorroOntology/System"/>
    </owl:ObjectProperty>
    


    <!-- http://w3id.org/ZorroOntology/involves -->


    <owl:ObjectProperty rdf:about="http://w3id.org/ZorroOntology/involves">
        <rdfs:domain rdf:resource="http://w3id.org/ZorroOntology/Problem"/>
        <rdfs:range rdf:resource="http://w3id.org/ZorroOntology/Part"/>
    </owl:ObjectProperty>
    


    <!-- http://w3id.org/ZorroOntology/solves -->


    <owl:ObjectProperty rdf:about="http://w3id.org/ZorroOntology/solves">
        <rdfs:domain rdf:resource="hhttp://w3id.org/ZorroOntology/Solution"/>
        <rdfs:range rdf:resource="http://w3id.org/ZorroOntology/Problem"/>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://w3id.org/ZorroOntology/Assembly -->


    <owl:Class rdf:about="http://w3id.org/ZorroOntology/Assembly">
        <rdfs:subClassOf rdf:resource="http://w3id.org/ZorroOntology/Component"/>
    </owl:Class>
    


    <!-- http://w3id.org/ZorroOntology/Cause -->


    <owl:Class rdf:about="http://w3id.org/ZorroOntology/Cause">
        <rdfs:comment>Cause itself  is a problem</rdfs:comment>
          <owl:disjointWith rdf:resource="http://w3id.org/ZorroOntology/Solution"/>
        <owl:disjointWith rdf:resource="http://w3id.org/ZorroOntology/Component"/>
        <owl:disjointWith rdf:resource="http://w3id.org/ZorroOntology/Function"/>
    </owl:Class>
    


    <!-- http://w3id.org/ZorroOntology/Component -->


    <owl:Class rdf:about="http://w3id.org/ZorroOntology/Component">
        <rdfs:comment>A component can have one or more functions</rdfs:comment>
<owl:disjointWith rdf:resource="http://w3id.org/ZorroOntology/Solution"/>
        <owl:disjointWith rdf:resource="http://w3id.org/ZorroOntology/Cause"/>
        <owl:disjointWith rdf:resource="http://w3id.org/ZorroOntology/Function"/>
        <owl:disjointWith rdf:resource="http://w3id.org/ZorroOntology/Problem"/>
    </owl:Class>
    


    <!-- http://w3id.org/ZorroOntology/Function -->


    <owl:Class rdf:about="http://w3id.org/ZorroOntology/Function">
        <rdfs:comment>A function can be performed by one or several componenets</rdfs:comment>
        <owl:disjointWith rdf:resource="http://w3id.org/ZorroOntology/Solution"/>
        <owl:disjointWith rdf:resource="http://w3id.org/ZorroOntology/Cause"/>
        <owl:disjointWith rdf:resource="http://w3id.org/ZorroOntology/Component"/>
        <owl:disjointWith rdf:resource="http://w3id.org/ZorroOntology/Problem"/>

    </owl:Class>
    


    <!-- http://w3id.org/ZorroOntology/Part -->


    <owl:Class rdf:about="http://w3id.org/ZorroOntology/Part">
        <rdfs:subClassOf rdf:resource="http://w3id.org/ZorroOntology/Component"/>
    </owl:Class>
    


    <!-- http://w3id.org/ZorroOntology/Problem -->


    <owl:Class rdf:about="http://w3id.org/ZorroOntology/Problem">
        <owl:disjointWith rdf:resource="http://w3id.org/ZorroOntology/Solution"/>
        <owl:disjointWith rdf:resource="http://w3id.org/ZorroOntology/Function"/>
        <owl:disjointWith rdf:resource="http://w3id.org/ZorroOntology/Component"/>
    </owl:Class>




    <!-- http://w3id.org/ZorroOntology/Solution -->


    <owl:Class rdf:about="http://w3id.org/ZorroOntology/Solution">
        <rdfs:comment>Solution solves the cause of the problem</rdfs:comment>
        <owl:disjointWith rdf:resource="http://w3id.org/ZorroOntology/Problem"/>
        <owl:disjointWith rdf:resource="http://w3id.org/ZorroOntology/Cause"/>
        <owl:disjointWith rdf:resource="http://w3id.org/ZorroOntology/Function"/>
        <owl:disjointWith rdf:resource="http://w3id.org/ZorroOntology/Component"/>
    </owl:Class>
    


    <!-- http://w3id.org/ZorroOntology/System -->


    <owl:Class rdf:about="http://w3id.org/ZorroOntology/System">
        <rdfs:subClassOf rdf:resource="http://w3id.org/ZorroOntology/Component"/>
    </owl:Class>
</rdf:RDF>



