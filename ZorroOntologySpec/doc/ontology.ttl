@prefix : <http://w3id.org/ZorroOntology/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <http://w3id.org/ZorroOntology/> .

<http://w3id.org/ZorroOntology/> rdf:type owl:Ontology .

#################################################################
#    Object Properties
#################################################################

###  http://w3id.org/ZorroOntology/PartOf
:PartOf rdf:type owl:ObjectProperty ;
        rdfs:domain :Part ;
        rdfs:range :Assembly .


###  http://w3id.org/ZorroOntology/defines
:defines rdf:type owl:ObjectProperty ;
         rdfs:domain :Function ;
         rdfs:range :Problem .


###  http://w3id.org/ZorroOntology/dependsOn
:dependsOn rdf:type owl:ObjectProperty ,
                    owl:TransitiveProperty ;
           rdfs:domain :Function ;
           rdfs:range :Function .


###  http://w3id.org/ZorroOntology/failsVia
:failsVia rdf:type owl:ObjectProperty ;
          rdfs:domain :Component ;
          rdfs:range :Problem .

###  http://w3id.org/ZorroOntology/hasEffect
:failsVia rdf:type owl:ObjectProperty ;
          rdfs:domain :Cause ;
          rdfs:range :Effect .


###  http://w3id.org/ZorroOntology/hasCause
:hasCause rdf:type owl:ObjectProperty ;
          rdfs:domain :Problem ;
          rdfs:range :Cause .


###  http://w3id.org/ZorroOntology/hasFunction
:hasFunction rdf:type owl:ObjectProperty ;
             rdfs:domain :Component ;
             rdfs:range :Function .


###  http://w3id.org/ZorroOntology/inSystem
:inSystem rdf:type owl:ObjectProperty ;
          rdfs:domain :Assembly ;
          rdfs:range :System .


###  http://w3id.org/ZorroOntology/involves
:involves rdf:type owl:ObjectProperty ;
          rdfs:domain :Problem ;
          rdfs:range :Part .


###  http://w3id.org/ZorroOntology/solves
:solves rdf:type owl:ObjectProperty ;
        rdfs:domain :Solution ;
        rdfs:range :Problem .


#################################################################
#    Classes
#################################################################

###  http://w3id.org/ZorroOntology/Assembly
:Assembly rdf:type owl:Class ;
          rdfs:subClassOf :Component .


###  http://w3id.org/ZorroOntology/Cause
:Cause rdf:type owl:Class ;
       rdfs:comment "Cause itself  is a problem" ;
        owl:disjointWith :Solution;
        owl:disjointWith :Function;
        owl:disjointWith :Component.


###  http://w3id.org/ZorroOntology/Effect
:Effect rdf:type owl:Class ;
       rdfs:comment "Effect is also a problem" ;
        owl:disjointWith :Solution;
        owl:disjointWith :Function;
        owl:disjointWith :Component.



###  http://w3id.org/ZorroOntology/Component
:Component rdf:type owl:Class ;
           rdfs:comment "A component can have one or more functions" ;
        owl:disjointWith :Solution;
        owl:disjointWith :Function;
        owl:disjointWith :Problem.
        owl:disjointWith :Effect.
        owl:disjointWith :Cause.


###  http://w3id.org/ZorroOntology/Function
:Function rdf:type owl:Class ;
          rdfs:comment "A function can be performed by one or several componenets" ;
owl:disjointWith :Solution;
        owl:disjointWith :Problem;
        owl:disjointWith :Component.
        owl:disjointWith :Effect.
        owl:disjointWith :Cause.


###  http://w3id.org/ZorroOntology/Part
:Part rdf:type owl:Class ;
      rdfs:subClassOf :Component .


###  http://w3id.org/ZorroOntology/Problem
:Problem rdf:type owl:Class ;
        owl:disjointWith :Solution;
        owl:disjointWith :Function;
        owl:disjointWith :Component.



###  http://w3id.org/ZorroOntology/Solution
:Solution rdf:type owl:Class ;
          rdfs:comment "Solution solves the cause of the problem" ;
        owl:disjointWith :Problem;
        owl:disjointWith :Function;
        owl:disjointWith :Component;
        owl:disjointWith :Cause.
       owl:disjointWith :Effect.


###  http://w3id.org/ZorroOntology/System
:System rdf:type owl:Class ;
        rdfs:subClassOf :Component .


